# Fichier .env pour l'environnement de développement

# Profil de l'application Spring Boot
SPRING_PROFILES_ACTIVE=dev
APPLICATION_LOG_PATH=/logs/apievent
APPLICATION_LOG_PATH_EVENT_NOTIF=/logs/eventnotifications
APPLICATION_LOG_PATH_EVENT_STATS=/logs/eventstats

# Identifiants pour la base de données PostgreSQL
DB_HOST=postgres
DB_USER=event
DB_PASSWORD=monchichi
DB_NAME=event

# --- Kafka ---
# Dans Docker, on utilise le port interne 29092 et les noms de services
KAFKA_BOOTSTRAP=kafka1:29092,kafka2:29092,kafka3:29092

# Mot de passe pour Redis
REDIS_HOST=redis-event
REDIS_PASSWORD=devpassword
REDIS_PORT=6379
